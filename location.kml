<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Aashiyana Decor - Jaipur Stone Atelier, Stockyard &amp; Delivery Network</name>
    <description>Authorized Specta Quartz, Imported Italian Marble, Gangsaw Granite, and Designer Vitrified Tiles in Jaipur, Rajasthan.</description>

    <!-- ═══ SHOWROOM & STOCKYARD HEADQUARTERS ═══ -->
    <Placemark>
      <name>Aashiyana Decor - Showroom &amp; Stockyard</name>
      <description>Plot No. 8, Opp. Metro Pillar No. 30, Gopalpura Bypass, Mansarovar, Jaipur, Rajasthan 302020. Phone: +91 94686 34597. Authorized Specta Quartz dealer, imported Italian marble, and gangsaw granite stockyard.</description>
      <Point>
        <coordinates>75.7520,26.8680,0</coordinates>
      </Point>
    </Placemark>

    <!-- ═══ GREATER JAIPUR SERVICE DELIVERY BOUNDARY (POLYGON) ═══ -->
    <Placemark>
      <name>Aashiyana Decor - Greater Jaipur Primary Delivery Zone</name>
      <description>Full crane delivery, padded slab transport, and on-site dry-lay inspection polygon covering Mansarovar, Vaishali Nagar, C-Scheme, Civil Lines, Malviya Nagar, Jagatpura, and Ajmer Road corridor.</description>
      <Polygon>
        <extrude>1</extrude>
        <altitudeMode>clampToGround</altitudeMode>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              75.7200,26.9200,0
              75.8050,26.9180,0
              75.8300,26.8900,0
              75.8250,26.8450,0
              75.8550,26.8100,0
              75.7850,26.8000,0
              75.7400,26.8400,0
              75.7150,26.8750,0
              75.7200,26.9200,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- ═══ NEIGHBORHOOD DELIVERY HUBS ═══ -->
